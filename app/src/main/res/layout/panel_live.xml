<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#0A0A0F">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SPIRIT SCAN"
            android:textColor="#7CFFB2"
            android:textStyle="bold"
            android:textSize="16sp"
            android:letterSpacing="0.12" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="ACTIVITY"
            android:textColor="#888888"
            android:textSize="11sp" />

        <ProgressBar
            android:id="@+id/activityBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginTop="6dp"
            android:max="100"
            android:progress="5"
            android:progressTint="#7CFFB2"
            android:progressBackgroundTint="#222233" />

        <TextView
            android:id="@+id/labelText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="WAITING"
            android:textColor="#7CFFB2"
            android:textStyle="bold"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/metaText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="SYSTEM"
            android:textColor="#AAAAAA"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/narrativeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Listening..."
            android:textColor="#E8E8E8"
            android:textSize="15sp"
            android:lineSpacingExtra="3dp" />

        <TextView
            android:id="@+id/questionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text=""
            android:textColor="#777777"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="starting..."
            android:textColor="#666666"
            android:textSize="11sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="ASK THE FIELD"
            android:textColor="#999999"
            android:textSize="11sp" />

        <EditText
            android:id="@+id/askInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="What is influencing this reading?"
            android:textColor="#E0E0E0"
            android:textColorHint="#666666"
            android:backgroundTint="#7CFFB2"
            android:inputType="text"
            android:imeOptions="actionSend"
            android:maxLines="1" />

        <Button
            android:id="@+id/askButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="ASK"
            android:textColor="#0A0A0F"
            android:backgroundTint="#7CFFB2" />
    </LinearLayout>
</ScrollView>
